# Adresse publique de l'API Laravel (exposée au navigateur).
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Domaine de production, sans « / » final (canonique, sitemap, robots). Vide = balises non émises.
NUXT_PUBLIC_SITE_URL=

# Optionnel : adresse de l'API utilisée pendant le rendu serveur (réseau interne).
NUXT_API_BASE_SERVER=
